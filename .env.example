DATABASE_URL="file:./prisma/data.db"
ALLOW_INDEXING="true"

# better-auth: session signing/encryption secret; generate with `openssl rand -hex 32`
BETTER_AUTH_SECRET="super-duper-s3cret"
# canonical origin for auth callbacks/links — set on Fly; inferred from the
# request in local dev, so it can stay unset here
# BETTER_AUTH_URL="https://mokupona.ch"

# Google OAuth (optional — the "Continue with Google" buttons hide while unset)
# GOOGLE_CLIENT_ID="....apps.googleusercontent.com"
# GOOGLE_CLIENT_SECRET="..."

# outbound mail: "console" (dev default), "capture" (e2e), "resend" (prod/staging)
MAIL_PROVIDER="console"
# only needed when MAIL_PROVIDER="resend"
# RESEND_API_KEY="re_..."
# MAIL_FROM="moku pona <no-reply@mail.mokupona.ch>"

# renders the <script data-cy-bootstrap> hydration marker for Cypress
# (set automatically by the test:e2e:* scripts — leave unset otherwise)
# CYPRESS_SUPPORT="true"

# image storage: "local" (dev/CI default — offline, secret-free) or "cloudinary"
# IMAGE_PROVIDER="local"
# where the local provider keeps files (defaults to a stable temp directory)
# IMAGE_UPLOAD_FOLDER="./tmp/image-uploads"
# only needed when IMAGE_PROVIDER="cloudinary"
# CLOUDINARY_CLOUD_NAME="..."
# CLOUDINARY_API_KEY="..."
# CLOUDINARY_API_SECRET="..."
# CLOUDINARY_FOLDER_PREFIX="dev"
