{
  "name": "mokupona-4755",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "imports": {
    "#prisma/*": "./prisma/*.ts"
  },
  "scripts": {
    "build": "prisma generate && react-router build",
    "dev": "node ./mocks/index.js & react-router dev --host",
    "format": "prettier --write .",
    "lint": "eslint --cache --cache-location ./node_modules/.cache/eslint .",
    "setup": "prisma generate && prisma migrate deploy && prisma db seed",
    "start": "react-router-serve ./build/server/index.js",
    "start:mocks": "node ./mocks/index.js & react-router-serve ./build/server/index.js",
    "test": "vitest",
    "test:e2e:dev": "cross-env MAIL_PROVIDER=capture CYPRESS_SUPPORT=true start-server-and-test dev http://localhost:3000 \"npx cypress open\"",
    "pretest:e2e:run": "npm run build",
    "test:e2e:ci": "npm --ignore-scripts run test:e2e:run",
    "test:e2e:run": "cross-env PORT=8811 MAIL_PROVIDER=capture CYPRESS_SUPPORT=true BETTER_AUTH_URL=http://localhost:8811 start-server-and-test start:mocks http://localhost:8811 \"npx cypress run\"",
    "typecheck": "prisma generate &&react-router typegen && tsc && tsc -p cypress",
    "validate": "run-p \"test -- --run\" lint typecheck test:e2e:run",
    "prisma:studio": "prisma studio"
  },
  "prettier": {
    "plugins": [
      "prettier-plugin-tailwindcss"
    ]
  },
  "eslintIgnore": [
    "/node_modules",
    "/build",
    "/public/build"
  ],
  "dependencies": {
    "@conform-to/react": "^1.20.0",
    "@conform-to/zod": "^1.20.0",
    "@prisma/adapter-better-sqlite3": "^7.9.0",
    "@prisma/client": "^7.9.0",
    "@radix-ui/react-icons": "^1.3.2",
    "@react-router/fs-routes": "^8.3.0",
    "@react-router/node": "^8.3.0",
    "@react-router/serve": "^8.3.0",
    "@remix-run/file-storage": "^0.13.7",
    "@remix-run/form-data-parser": "^0.17.4",
    "better-auth": "^1.6.25",
    "class-variance-authority": "^0.7.1",
    "cloudinary": "^2.10.0",
    "clsx": "^2.1.1",
    "dotenv": "^17.4.2",
    "isbot": "^5.2.1",
    "prisma": "^7.9.0",
    "radix-ui": "^1.6.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "^8.3.0",
    "resend": "^6.18.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tailwindcss-animate": "^1.0.7",
    "tiny-invariant": "^1.3.3",
    "tsx": "^4.23.1",
    "winston": "^3.19.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.5.0",
    "@react-router/dev": "^8.3.0",
    "@remix-run/lazy-file": "^5.0.6",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/cypress": "^10.1.3",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitest/coverage-v8": "^4.1.10",
    "cross-env": "^10.1.0",
    "cypress": "^15.19.0",
    "eslint": "^10.8.0",
    "eslint-plugin-cypress": "^6.4.3",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-jest-dom": "^5.5.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.7.0",
    "happy-dom": "^20.11.1",
    "msw": "^2.15.0",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "start-server-and-test": "^3.0.11",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  },
  "optionalDependencies": {
    "@rollup/rollup-linux-x64-gnu": "^4.62.3"
  },
  "engines": {
    "node": ">=24.13.0"
  }
}
