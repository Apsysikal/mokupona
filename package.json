{
  "name": "mokupona-4755",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "imports": {
    "#prisma/*": "./prisma/*.ts"
  },
  "scripts": {
    "build": "prisma generate && react-router build",
    "dev": "node ./mocks/index.js & react-router dev --host",
    "format": "prettier --write .",
    "lint": "eslint --cache --cache-location ./node_modules/.cache/eslint .",
    "setup": "prisma generate && prisma migrate deploy && prisma db seed",
    "start": "react-router-serve ./build/server/index.js",
    "start:mocks": "node ./mocks/index.js & react-router-serve ./build/server/index.js",
    "test": "vitest",
    "test:e2e:dev": "cross-env MAIL_PROVIDER=capture CYPRESS_SUPPORT=true start-server-and-test dev http://localhost:3000 \"npx cypress open\"",
    "pretest:e2e:run": "npm run build",
    "test:e2e:ci": "npm --ignore-scripts run test:e2e:run",
    "test:e2e:run": "cross-env PORT=8811 MAIL_PROVIDER=capture CYPRESS_SUPPORT=true BETTER_AUTH_URL=http://localhost:8811 start-server-and-test start:mocks http://localhost:8811 \"npx cypress run\"",
    "typecheck": "prisma generate &&react-router typegen && tsc && tsc -p cypress",
    "validate": "run-p \"test -- --run\" lint typecheck test:e2e:run",
    "prisma:studio": "prisma studio"
  },
  "prettier": {
    "plugins": [
      "prettier-plugin-tailwindcss"
    ]
  },
  "eslintIgnore": [
    "/node_modules",
    "/build",
    "/public/build"
  ],
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@conform-to/react": "^1.21.1",
    "@conform-to/zod": "^1.21.1",
    "@prisma/adapter-better-sqlite3": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@react-router/fs-routes": "^8.4.0",
    "@react-router/node": "^8.3.0",
    "@react-router/serve": "^8.4.0",
    "@remix-run/file-storage": "^1.0.0",
    "@remix-run/form-data-parser": "^1.0.0",
    "better-auth": "^1.7.7",
    "class-variance-authority": "^0.7.1",
    "cloudinary": "^2.11.0",
    "clsx": "^2.1.1",
    "dotenv": "^18.0.7",
    "embla-carousel-react": "^8.6.0",
    "image-size": "^2.0.4",
    "isbot": "^5.2.2",
    "lucide-react": "^1.55.0",
    "pino": "^10.4.0",
    "pino-pretty": "^13.2.0",
    "prisma": "^7.10.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^8.4.0",
    "resend": "^6.32.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tiny-invariant": "^1.3.3",
    "tsx": "^4.23.15",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.6.0",
    "@react-router/dev": "^8.4.0",
    "@remix-run/lazy-file": "^5.0.8",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/cypress": "^10.1.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "^5.0.3",
    "cross-env": "^10.1.0",
    "cypress": "^15.21.1",
    "eslint": "^10.12.0",
    "eslint-plugin-cypress": "^6.4.4",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-jest-dom": "^5.10.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "happy-dom": "^20.14.6",
    "msw": "^3.0.3",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "shadcn": "^4.21.4",
    "start-server-and-test": "^3.0.13",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  },
  "optionalDependencies": {
    "@rollup/rollup-linux-x64-gnu": "^4.64.5"
  },
