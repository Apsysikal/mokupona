generator client {
  provider      = "prisma-client"
  output        = "./generated"
  // The WASM query compiler is the app's single largest allocation: the default
  // "fast" build costs ~60 MB more boot-time peak on a 256 MB Fly machine, and
  // measured no faster on our query shapes. See docs/memory-profile/findings.md.
  compilerBuild = "small"
}

datasource db {
  provider = "sqlite"
}

model User {
  id            String  @id @default(cuid())
  email         String  @unique
  name          String
  emailVerified Boolean @default(false)
  image         String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sessions Session[]
  accounts Account[]

  invitesCreated Invite[]

  events Event[]

  role   Role   @relation(fields: [roleId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  roleId String
}

// Session / Account / Verification are owned by better-auth (1.6 field set,
// hand-merged — the CLI must never rewrite this file; our User carries the
// roleId relation and events).

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  userId String

  @@index([userId])
}

model Account {
  id String @id @default(cuid())

  // provider user id ("credential" accounts reuse the user id)
  accountId  String
  providerId String

  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  // scrypt hash for providerId = "credential"
  password              String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  userId String

  @@index([userId])
}

model Invite {
  id         String    @id @default(cuid())
  // bound address — must match at acceptance
  email      String
  // "user" | "moderator"
  roleName   String
  tokenHash  String    @unique
  expiresAt  DateTime
  acceptedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  createdBy   User   @relation(fields: [createdById], references: [id], onDelete: Cascade, onUpdate: Cascade)
  createdById String

  @@index([email])
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([identifier])
}

model Role {
  id          String @id @default(cuid())
  // user, moderator, admin
  name        String @unique
  description String @default("")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users User[]
}

model Event {
  id                  String   @id @default(cuid())
  title               String
  description         String
  menuDescription     String?
  donationDescription String?
  date                DateTime
  slots               Int
  price               Int
  discounts           String?

  // cover lives on Image (eventId, Cascade) like BoardMember portraits, so
  // deleting an image can never take the event with it
  image Image?

  addressId String
  address   Address @relation(fields: [addressId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  eventResponses EventResponse[]

  // authorship metadata only — events outlive their creator
  createdBy   User?   @relation(fields: [createdById], references: [id], onDelete: SetNull, onUpdate: Cascade)
  createdById String?

  form   Form   @relation(fields: [formId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  formId String @unique // non-nullable: every event has a form (backfilled)

  // ── gallery prototypes ────────────────────────────────────────────────
  // One back-relation per competing foundation (see the Gallery block at the
  // bottom of this file). Exactly one of these survives the prototype phase;
  // the other two go out with their tables.
  galleryImages  Image[]             @relation("EventGallery") // A — tagged
  galleryEntries EventGalleryEntry[] // B — join
  album          Album? // C — album
}

model Form {
  id String @id @default(cuid())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  versions FormVersion[]
  event    Event? // back-relation only; Form itself stays event-agnostic
}

model FormVersion {
  id      String @id @default(cuid())
  version Int
  schema  Json // FieldDescriptor[]; validated by SignupFormSchema on every write

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt // mutated in place only while no submissions reference it

  form   Form   @relation(fields: [formId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  formId String

  submissions FormSubmission[]

  @@unique([formId, version])
}

model FormSubmission {
  id      String @id @default(cuid())
  answers Json // nested: { name, email, …, friends: [{ name, … }] }

  createdAt DateTime @default(now())

  formVersion   FormVersion @relation(fields: [formVersionId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  formVersionId String
}

model EventResponse {
  id           String   @id @default(cuid())
  name         String
  email        String
  phone        String   @default("")
  vegetarian   Boolean?
  student      Boolean?
  restrictions String?
  comment      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  eventId String
}

model Address {
  id          String  @id @default(cuid())
  streetName  String
  houseNumber String
  zip         String
  city        String
  events      Event[]

  @@unique([streetName, houseNumber, zip, city])
}

model Image {
  id          String  @id @default(cuid())
  altText     String?
  contentType String
  // provider key (Cloudinary public_id / local file key) — the row's only
  // link to its bytes since `blob` was dropped, so it is required
  storageKey  String
  // Cloudinary asset version — versioned delivery URLs
  version     Int?
  // intrinsic pixels, from the upload response
  width       Int?
  height      Int?
  // base64 blur-up placeholder (~1–2 KB), generated at store/backfill time
  blurDataUrl String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  boardMember   BoardMember? @relation(fields: [boardMemberId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  boardMemberId String?      @unique

  // the cover slot — @unique, so at most one per event
  event   Event?  @relation(fields: [eventId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  eventId String? @unique

  // ── gallery prototypes ────────────────────────────────────────────────
  // Shared by the foundations that hang their metadata off the image row
  // itself (A and C); foundation B keeps caption/position on its join row so
  // the same image can read differently in two galleries.
  caption  String?
  position Int     @default(0)

  // A — "tagged": a second, non-unique event FK next to the cover's. Cheapest
  // possible change; an image belongs to at most one dinner's gallery.
  galleryEvent   Event?  @relation("EventGallery", fields: [galleryEventId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  galleryEventId String?

  // B — "join": membership lives on EventGalleryEntry, so one image can
  // appear in several dinners (and in none).
  galleryEntries EventGalleryEntry[]

  // C — "album": images belong to an album, which may or may not belong to
  // an event.
  album   Album?  @relation(fields: [albumId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  albumId String?

  @@index([galleryEventId])
  @@index([albumId])
}

// ── Gallery foundation B: "join" ────────────────────────────────────────
// Image rows stay ownerless; an entry grants one image membership in one
// dinner's gallery. Deleting an entry unlinks without destroying the asset,
// and the same photo can be shown under two dinners with different captions.
model EventGalleryEntry {
  id       String  @id @default(cuid())
  caption  String?
  position Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  eventId String

  image   Image  @relation(fields: [imageId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  imageId String

  // one membership per (dinner, image) pair — re-adding is idempotent
  @@unique([eventId, imageId])
  @@index([eventId])
  @@index([imageId])
}

// ── Gallery foundation C: "album" ───────────────────────────────────────
// Galleries become first-class: an album carries its own title/description
// and MAY belong to an event (@unique — at most one album per dinner), so
// standalone albums ("kitchen life") cost nothing extra.
model Album {
  id          String @id @default(cuid())
  title       String
  description String @default("")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  images Image[]

  event   Event?  @relation(fields: [eventId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  eventId String? @unique
}

model BoardMember {
  id       String @id @default(cuid())
  name     String
  position String

  image Image?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
